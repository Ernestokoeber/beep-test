# PostgreSQL: in Produktion einen gepoolten TLS-Connection-String verwenden.
DATABASE_URL=postgres://user:password@host/database?sslmode=require

# Mindestens 48 zufällige Bytes, z.B. mit: openssl rand -base64 48
JWT_SECRET=

# Serverseitiger Google-Gemini-Schlüssel. Niemals ins Frontend übernehmen.
GEMINI_API_KEY=

# Reserviert das erste Administratorkonto und verhindert eine öffentliche Übernahme.
BOOTSTRAP_ADMIN_EMAIL=

# Gemeinsamer Einladungscode für weitere TSV-Trainerkonten.
REGISTRATION_INVITE_CODE=

TEAM_NAME=TSV Lindau Basketball
TEAM_SLUG=tsv-lindau-basketball
AI_RATE_LIMIT=30
