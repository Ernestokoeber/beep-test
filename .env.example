# PostgreSQL: in Produktion einen gepoolten TLS-Connection-String verwenden.
DATABASE_URL=postgres://user:password@host/database?sslmode=require

# Mindestens 48 zufällige Bytes, z.B. mit: openssl rand -base64 48
JWT_SECRET=

# Serverseitiger Google-Gemini-Schlüssel. Niemals ins Frontend übernehmen.
GEMINI_API_KEY=

# Reserviert das erste Administratorkonto und verhindert eine öffentliche Übernahme.
BOOTSTRAP_ADMIN_EMAIL=

# Gemeinsamer Einladungscode für weitere TSV-Trainerkonten.
REGISTRATION_INVITE_CODE=

TEAM_NAME=TSV Lindau Basketball
TEAM_SLUG=tsv-lindau-basketball
AI_RATE_LIMIT=30

# Öffentliche TSV-Datenquelle für Spielplan und Kalender.
TSV_WEBSITE_API_URL=https://tsv-lindau-basketball-api.ekoeber.workers.dev

# Project Atlas bleibt ein eigener Dienst. Nur die Basis-URL ist zwingend;
# ein Token wird gesetzt, falls der Atlas-Endpunkt nicht öffentlich ist.
ATLAS_API_URL=
ATLAS_API_TOKEN=
ATLAS_WEBHOOK_SECRET=
ATLAS_ACCESS_CLIENT_ID=
ATLAS_ACCESS_CLIENT_SECRET=
ATLAS_IDENTITY_EMAIL=

# Kanonische PWA-Adresse für QR-Check-ins.
PUBLIC_APP_URL=https://coach.tsv-lindau.de
