{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/ai/gemini.js": {
      "maxDuration": 60
    },
    "api/games/sync.js": {
      "maxDuration": 30
    },
    "api/games/atlas.js": {
      "maxDuration": 30
    },
    "api/individual/ai-drafts.js": {
      "maxDuration": 60
    },
    "api/individual/reminders.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/individual/reminders?slot=monday-summer", "schedule": "15 16 * * 1" },
    { "path": "/api/individual/reminders?slot=monday-winter", "schedule": "15 17 * * 1" },
    { "path": "/api/individual/reminders?slot=friday-summer", "schedule": "15 16 * * 5" },
    { "path": "/api/individual/reminders?slot=friday-winter", "schedule": "15 17 * * 5" },
    { "path": "/api/individual/reminders?slot=saturday-summer", "schedule": "0 10 * * 6" },
    { "path": "/api/individual/reminders?slot=saturday-winter", "schedule": "0 11 * * 6" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
