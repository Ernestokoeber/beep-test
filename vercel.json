{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/ai/gemini.js": {
      "maxDuration": 60
    },
    "api/games/sync.js": {
      "maxDuration": 30
    },
    "api/games/atlas.js": {
      "maxDuration": 30
    },
    "api/individual/ai-drafts.js": {
      "maxDuration": 60
    },
    "api/individual/reminders.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/individual/reminders", "schedule": "*/15 * * * *" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
